/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quadchat-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-07-21",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "PRESENCE",
				"class_name": "PresenceServer"
			},
			{
				"name": "PAIRING_CODE",
				"class_name": "PairingCode"
			},
			{
				"name": "COMPANION_RELAY",
				"class_name": "CompanionRelay"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-companion-relay",
			"new_sqlite_classes": ["PresenceServer", "PairingCode", "CompanionRelay"]
		}
	]
}
