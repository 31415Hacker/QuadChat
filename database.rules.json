{
  "rules": {
    // -----------------------------------------------------------------
    // TYPING INDICATORS (Used in App.jsx under /typing/$channel/$uid)
    // -----------------------------------------------------------------
    "typing": {
      "$channel": {
        // Anyone logged in can read who is typing in a channel
        ".read": "auth != null",
        ".indexOn": ["timestamp"],
        "$uid": {
          // Users can only update/remove their own typing status
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['isTyping', 'timestamp'])",
          "isTyping": {
            ".validate": "newData.isBoolean()"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },

    // -----------------------------------------------------------------
    // ONE-ON-ONE WEBRTC CALLS
    // -----------------------------------------------------------------
    "calls": {
      "$callId": {
        // Only caller or callee can view or interact with the call object
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid || !data.exists())",
        ".write": "auth != null && (!data.exists() && newData.child('callerId').val() === auth.uid || data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        
        "status": {
          ".validate": "newData.isString()"
        },
        "candidates": {
          "caller": {
            ".read": "auth != null && (data.parent().parent().child('callerId').val() === auth.uid || data.parent().parent().child('calleeId').val() === auth.uid)",
            ".write": "auth != null && data.parent().parent().child('callerId').val() === auth.uid"
          },
          "callee": {
            ".read": "auth != null && (data.parent().parent().child('callerId').val() === auth.uid || data.parent().parent().child('calleeId').val() === auth.uid)",
            ".write": "auth != null && data.parent().parent().child('calleeId').val() === auth.uid"
          }
        },
        "renego": {
          ".read": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)",
          ".write": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)"
        }
      }
    },

    // -----------------------------------------------------------------
    // P2P / GROUP CALL SIGNALING
    // -----------------------------------------------------------------
    "group-calls": {
      "$groupCallId": {
        ".read": "auth != null",
        ".write": "auth != null",
        
        "participants": {
          "$uid": {
            // Users can only add, modify, or remove their own participant entry
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "connections": {
          "$connId": {
            // Peer connection keys follow the 'uidA_uidB' pattern
            // Only participants in that pair can read/write candidates/SDP signals
            ".read": "auth != null && $connId.contains(auth.uid)",
            ".write": "auth != null && $connId.contains(auth.uid)"
          }
        }
      }
    }
  }
}

