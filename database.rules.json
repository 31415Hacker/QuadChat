{
  "rules": {
    // -----------------------------------------------------------------
    // TYPING INDICATORS (Used in App.jsx under /typing/$channel/$uid)
    // -----------------------------------------------------------------
    "typing": {
      "$channel": {
        // Anyone logged in can read who is typing in a channel
        ".read": "auth != null",
        ".indexOn": ["timestamp"],
        "$uid": {
          // Users can only update/remove their own typing status
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['isTyping', 'timestamp'])",
          "isTyping": {
            ".validate": "newData.isBoolean()"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },

    // -----------------------------------------------------------------
    // ONE-ON-ONE WEBRTC CALLS
    // -----------------------------------------------------------------
    "calls": {
      "$callId": {
        // Only the caller or callee can read or interact with a call object.
        // (Incoming-call detection no longer listens on the whole collection;
        // it uses per-user "call-rings" nodes below, so read stays private.)
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        // Only the caller or callee can create/interact with a call object.
        // Creation is limited to the caller writing their own callerId.
        ".write": "auth != null && (
          (!data.exists() && newData.child('callerId').val() === auth.uid)
          || data.child('callerId').val() === auth.uid
          || data.child('calleeId').val() === auth.uid
        )",

        // Caller/callee identities are locked after creation so they can't be rewritten
        "callerId": {
          ".validate": "!data.exists() || newData.val() === data.val()"
        },
        "calleeId": {
          ".validate": "!data.exists() || newData.val() === data.val()"
        },
        "callerName": {
          ".validate": "newData.isString()"
        },
        "calleeName": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "startedAt": {
          ".validate": "newData.isNumber()"
        },
        "offer": {
          ".validate": "newData.hasChildren(['type', 'sdp']) && newData.child('type').isString() && newData.child('sdp').isString()"
        },
        "answer": {
          ".validate": "newData.hasChildren(['type', 'sdp']) && newData.child('type').isString() && newData.child('sdp').isString()"
        },
        "callerMuted": {
          ".validate": "newData.isBoolean()"
        },
        "calleeMuted": {
          ".validate": "newData.isBoolean()"
        },
        "screenShareActive": {
          ".validate": "newData.isBoolean() || (newData.hasChildren(['name']) && newData.child('name').isString())"
        },
        "screenShareRequest": {
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name']) && newData.child('uid').isString() && newData.child('name').isString())"
        },
        "candidates": {
          "caller": {
            ".read": "auth != null && (data.parent().parent().child('callerId').val() === auth.uid || data.parent().parent().child('calleeId').val() === auth.uid)",
            ".write": "auth != null && data.parent().parent().child('callerId').val() === auth.uid"
          },
          "callee": {
            ".read": "auth != null && (data.parent().parent().child('callerId').val() === auth.uid || data.parent().parent().child('calleeId').val() === auth.uid)",
            ".write": "auth != null && data.parent().parent().child('calleeId').val() === auth.uid"
          }
        },
        "renego": {
          ".read": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)",
          ".write": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)"
        }
      }
    },

    // -----------------------------------------------------------------
    // INCOMING-CALL RINGS
    // Each user has their own node under call-rings/$uid. A caller writes a
    // small ring entry into the callee's node when starting a call, and the
    // callee listens only on their own node (onChildAdded). Nobody else can
    // see or write a user's rings, so call metadata is never broadcast.
    // -----------------------------------------------------------------
    "call-rings": {
      "$uid": {
        // Only the ring owner can read their own rings.
        ".read": "auth != null && auth.uid === $uid",
        // The owner can manage the collection. Callers are authorized at the
        // individual ring node below, where callerId/calleeId are present.
        ".write": "auth != null && auth.uid === $uid",
        "$callKey": {
          ".write": "auth != null && (
            auth.uid === $uid
            || (newData.child('callerId').val() === auth.uid && newData.child('calleeId').val() === $uid)
          )",
          ".validate": "!newData.exists() || (
            newData.child('callKey').val() === $callKey
            && newData.child('calleeId').val() === $uid
            && newData.child('callerId').val() === auth.uid
            && newData.child('callerId').isString()
            && newData.child('calleeId').isString()
            && newData.child('callerName').isString()
            && newData.child('calleeName').isString()
            && newData.child('startedAt').isNumber()
            && newData.child('callKey').isString()
          )"
        }
      }
    },

    // -----------------------------------------------------------------
    // MISSED-CALL RECORDS
    // When an incoming call ring goes stale (>20 s), the callee's client
    // moves it here instead of dropping it, so an offline user learns who
    // called them on reconnect. Each user only ever sees/writes their own
    // node; the callee's client drains it into the notification center.
    // -----------------------------------------------------------------
    "missed-calls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$callKey": {
          ".validate": "!newData.exists() || (
            newData.child('callKey').val() === $callKey
            && newData.child('callerId').isString()
            && newData.child('callerName').isString()
            && newData.child('startedAt').isNumber()
            && newData.child('callKey').isString()
          )"
        }
      }
    },

    // -----------------------------------------------------------------
    // DIR group call directory
    // A public listing of creatable/joinable group calls. The directory
    // entry only records metadata + password hash; live participants live
    // under group-calls/<key>/participants. Token issuance is the password
    // gate (server verifies before issuing a LiveKit token for the room).
    // -----------------------------------------------------------------
    "call-directory": {
      ".read": "auth != null",
      // Anyone may create a call (validated below); the entry may only be
      // removed/rewritten by its owner. `request.resource` is null on delete,
      // which keeps the owner's delete allowed.
      ".write": "auth != null && (
        request.resource == null ||
        request.resource.child('ownerId').val() == auth.uid
      )",
      "$callKey": {
        ".validate": "(
          newData.child('callKey').val() === $callKey
          && newData.child('callKey').isString()
          && newData.child('title').isString()
          && newData.child('title').val().length <= 50
          && newData.child('ownerId').isString()
          && newData.child('ownerName').isString()
          && newData.child('createdAt').isNumber()
          && (!newData.hasChild('passwordHash') || (
            newData.child('passwordHash').isString()
            && newData.child('passwordHash').val().length === 64
            && newData.hasChild('passwordSalt')
            && newData.child('passwordSalt').isString()
          ))
        )"
      }
    },

    // -----------------------------------------------------------------
    // P2P / GROUP CALL SIGNALING
    // -----------------------------------------------------------------
    "group-calls": {
      "$groupCallId": {
        ".read": "auth != null",
        // The first joiner creates the call (createdAt + participants) before
        // any participant entries exist, so the parent write stays open to all
        // signed-in users. Shape is validated and per-node rules below lock
        // participants and connections down.
        ".write": "auth != null",

        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "screenShareActive": {
          ".validate": "newData.isBoolean() || (newData.hasChildren(['name']) && newData.child('name').isString())"
        },
        "screenShareRequest": {
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name']) && newData.child('uid').isString() && newData.child('name').isString())"
        },

        "participants": {
          // Whole-map writes denied; users can only touch their own entry below
          ".write": false,
          "$uid": {
            // Users can only add, modify, or remove their own participant entry
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('joinedAt').isNumber()"
          }
        },
        "mutes": {
          // Per-call mutes are written ONLY by the serverless /api/group-mute
          // endpoint (admin SDK, which bypasses rules) after confirming the
          // caller is the call owner or an admin. Clients may read all mutes
          // (each client enforces its own mute locally) but can never write.
          ".read": "auth != null",
          ".write": false,
          "$uid": {
            ".validate": "(
              newData.hasChildren(['muted', 'mutedBy', 'mutedByName', 'targetName', 'updatedAt'])
              && newData.child('muted').isBoolean()
              && newData.child('mutedBy').isString()
              && newData.child('mutedByName').isString()
              && newData.child('targetName').isString()
              && newData.child('updatedAt').isNumber()
            )"
          }
        },
        "connections": {
          // Only the per-pair node below grants access
          ".read": false,
          ".write": false,
          "$connId": {
            // Peer connection keys follow the 'uidA_uidB' pattern (uids sorted).
            // Only the two participants in that pair can read/write signaling.
            // Firebase rules has no startsWith() method. Firebase UIDs are
            // alphanumeric, and the connection key contains exactly two UIDs
            // separated by '_', so these delimiter checks identify a pair.
            ".read": "auth != null && ($connId.contains(auth.uid + '_') || $connId.endsWith('_' + auth.uid))",
            ".write": "auth != null && ($connId.contains(auth.uid + '_') || $connId.endsWith('_' + auth.uid))"
          }
        }
      }
    }
  }
}
