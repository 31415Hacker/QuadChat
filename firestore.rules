rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function currentUserExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUserDoc() {
      return get(userPath(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (currentUserExists() && currentUserDoc().data.isAdmin == true)
      );
    }

    function isDeveloper() {
      return signedIn() && (
        request.auth.token.developer == true ||
        (currentUserExists() && currentUserDoc().data.isDeveloper == true)
      );
    }

    function isAdminEmail() {
      return signedIn() && 'email' in request.auth.token &&
        request.auth.token.email.lower() in ['ariqipraditya@gmail.com'];
    }

    function isNotMuted() {
      return signedIn() && (
        !currentUserExists() ||
        !("muted" in currentUserDoc().data) ||
        currentUserDoc().data.muted != true ||
        ("mutedUntil" in currentUserDoc().data &&
         currentUserDoc().data.mutedUntil is timestamp &&
         currentUserDoc().data.mutedUntil < request.time)
      );
    }

    // Messages
    match /messages/{channel} {
      allow read, write: if false;
    }

    match /messages/{channel}/messages/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && isNotMuted()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "text", "userId", "createdAt", "adminCommand", "command",
          "commandTarget", "notificationText", "targetUserId", "replyTo",
          "attachments", "isFile", "fileName", "fileType", "type",
          "title", "googleMeetLink", "note", "tableData", "name"
        ])
        && (!request.resource.data.keys().hasAny(["adminCommand", "command", "commandTarget", "notificationText", "targetUserId"]) || isAdmin())
        && (channel != "updates" || isDeveloper());

      allow update: if signedIn()
        && isNotMuted()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rsvps"])
        && (!("rsvps" in request.resource.data)
            || request.resource.data.rsvps
                .diff("rsvps" in resource.data ? resource.data.rsvps : {})
                .affectedKeys()
                .hasOnly([request.auth.uid]));

      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User Profiles
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn() && (
        isAdmin() || (
          userId == request.auth.uid &&
          (isAdminEmail() ||
           !request.resource.data.keys().hasAny(["isAdmin", "isDeveloper", "muted", "mutedUntil", "mutedBy", "mutedUpdatedAt"]))
        )
      );

      allow update: if signedIn() && (
        isAdmin() || (
          userId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["isAdmin", "isDeveloper", "muted", "mutedUntil"])
        )
      );

      allow delete: if signedIn() && (userId == request.auth.uid || isAdmin());
    }

    // Sessions Subcollection
    match /users/{userId}/sessions/{sessionId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;
    }

    // App Settings
    match /settings/app {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}