rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function currentUserExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUserDoc() {
      return get(userPath(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (currentUserExists() && currentUserDoc().data.isAdmin == true)
      );
    }

    function isDeveloper() {
      return signedIn() && (
        request.auth.token.developer == true ||
        (currentUserExists() && currentUserDoc().data.isDeveloper == true)
      );
    }

    function isAdminEmail() {
      return signedIn() && 'email' in request.auth.token &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() in ['ariqipraditya@gmail.com'];
    }

    function isNotMuted() {
      return signedIn() && (
        !currentUserExists() ||
        !("muted" in currentUserDoc().data) ||
        currentUserDoc().data.muted != true ||
        ("mutedUntil" in currentUserDoc().data &&
         currentUserDoc().data.mutedUntil is timestamp &&
         currentUserDoc().data.mutedUntil < request.time)
      );
    }

    function isProtectedAdminTarget() {
      return resource.data.isAdmin == true || request.resource.data.isAdmin == true;
    }

    // Admin-controlled kill switch in /settings/app. When signupEnabled is
    // false, new user documents can only be created by admins. This is
    // enforced by the server, so it blocks signup even from direct SDK /
    // API calls outside the app.
    function signupEnabled() {
      return !exists(/databases/$(database)/documents/settings/app)
        || get(/databases/$(database)/documents/settings/app).data.signupEnabled != false;
    }

    function isDmChannel(channel) {
      return channel.matches("dm_.*");
    }

    function dmParticipants(channel) {
      let path = /databases/$(database)/documents/dms/$(channel);
      return exists(path) && get(path).data.participants is list
        ? get(path).data.participants
        : [];
    }

    function isDmParticipant(channel) {
      return isDmChannel(channel) && request.auth.uid in dmParticipants(channel);
    }

    // Messages
    match /messages/{channel} {
      allow read, write: if false;
    }

    match /messages/{channel}/messages/{messageId} {
      allow read: if signedIn() && (!isDmChannel(channel) || isDmParticipant(channel));

      allow create: if signedIn()
        && isNotMuted()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "text", "userId", "createdAt", "adminCommand", "command",
          "commandTarget", "notificationText", "targetUserId", "replyTo",
          "attachments", "isFile", "fileName", "fileType", "type",
          "title", "googleMeetLink", "note", "tableData", "name"
        ])
        && (!request.resource.data.keys().hasAny(["adminCommand", "command", "commandTarget", "notificationText", "targetUserId"]) || isAdmin())
        && (!("text" in request.resource.data) || request.resource.data.text is string)
        && (!("text" in request.resource.data) || request.resource.data.text.size() <= 2500)
        && (!("attachments" in request.resource.data) || request.resource.data.attachments is list)
        && (!("fileName" in request.resource.data) || request.resource.data.fileName is string)
        && (!("fileType" in request.resource.data) || request.resource.data.fileType is string)
        && (!("type" in request.resource.data) || request.resource.data.type is string)
        && (!("title" in request.resource.data) || request.resource.data.title is string)
        && (!("note" in request.resource.data) || request.resource.data.note is string)
        && (!("googleMeetLink" in request.resource.data) || request.resource.data.googleMeetLink is string)
        && (channel != "updates" || isDeveloper())
        && (!isDmChannel(channel) || isDmParticipant(channel));

      allow update: if signedIn()
        && isNotMuted()
        && (
          (
            request.auth.uid == resource.data.userId
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "edited", "editedAt"])
             && (!("text" in request.resource.data) || request.resource.data.text is string)
             && (!("text" in request.resource.data) || request.resource.data.text.size() <= 2500)
            && (!("edited" in request.resource.data) || request.resource.data.edited is bool)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rsvps"])
            && (!("rsvps" in request.resource.data)
                || request.resource.data.rsvps
                    .diff("rsvps" in resource.data ? resource.data.rsvps : {})
                    .affectedKeys()
                    .hasOnly([request.auth.uid]))
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            && (!("reactions" in request.resource.data)
                || request.resource.data.reactions
                    .diff("reactions" in resource.data ? resource.data.reactions : {})
                    .affectedKeys()
                    .hasOnly([request.auth.uid]))
          )
        );

      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Direct Messages
    match /dms/{dmId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && dmId == "dm_" + request.resource.data.participants.join("_")
        && request.resource.data.keys().hasOnly(["participants", "names", "lastMessage", "lastSenderId", "updatedAt"]);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["names", "lastMessage", "lastSenderId", "updatedAt"]);
    }

    // User Profiles
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !(request.resource.data.isAdmin == true &&
             request.resource.data.keys().hasAny(["muted", "mutedUntil", "mutedBy", "mutedUpdatedAt"]))
        && (!("bio" in request.resource.data) ||
            (request.resource.data.bio is string && request.resource.data.bio.size() <= 280))
        && (!("schedule" in request.resource.data) || request.resource.data.schedule is map)
        && (
        isAdmin() || (
          signupEnabled() &&
          userId == request.auth.uid &&
          (isAdminEmail() ||
           !request.resource.data.keys().hasAny(["isAdmin", "isDeveloper", "muted", "mutedUntil", "mutedBy", "mutedUpdatedAt"]))
        )
      );

      allow update: if signedIn()
        && !(isProtectedAdminTarget() &&
             request.resource.data.diff(resource.data).affectedKeys().hasAny(["muted", "mutedUntil", "mutedBy", "mutedUpdatedAt"]))
        && (!("bio" in request.resource.data) ||
            (request.resource.data.bio is string && request.resource.data.bio.size() <= 280))
        && (!("schedule" in request.resource.data) || request.resource.data.schedule is map)
        && (
        isAdmin() || (
          userId == request.auth.uid &&
          (isAdminEmail() ||
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(["isAdmin", "isDeveloper", "muted", "mutedUntil", "mutedBy", "mutedUpdatedAt", "warning"]))
        )
      );

      allow delete: if signedIn() && (userId == request.auth.uid || isAdmin());
    }

    // Sessions Subcollection
    match /users/{userId}/sessions/{sessionId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;
    }

    // App Settings
    match /settings/app {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
