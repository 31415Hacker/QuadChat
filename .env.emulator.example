# Copy this file to .env.emulator, then start Vite with:
#   npm run dev:emulator
# These values only identify the local Firebase Emulator Suite. They are not
# credentials for, or connections to, the real quadchat-test project. The
# emulator ports are configured in firebase.json (19099, 18080, and 19000).
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=emulator-api-key
VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1
VITE_FIREBASE_PROJECT_ID=quadchat-test
VITE_FIREBASE_STORAGE_BUCKET=quadchat-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:quadchat-emulator
