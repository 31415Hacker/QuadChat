VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
# Optional developer-dashboard provider integrations. Configure these as Vercel
# server-side environment variables; do not prefix them with VITE_.
# CLOUDFLARE_API_TOKEN=token-with-Account-Workers-Scripts-Read
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# VERCEL_TOKEN=token-with-project-and-deployment-read-access
# VERCEL_PROJECT_ID=your-vercel-project-id
# GITHUB_TOKEN=token-with-Actions-read-access
# GITHUB_REPOSITORY=owner/repository
#
# Dashboard-managed provider connections. These are server-only. Generate a
# unique value for DASHBOARD_CREDENTIAL_ENCRYPTION_KEY and set all values in
# Vercel — never expose them as VITE_ variables.
# DASHBOARD_CREDENTIAL_ENCRYPTION_KEY=long-random-secret
# DASHBOARD_OAUTH_CALLBACK_URL=https://your-production-domain/api/provider-connect?callback=github
# GITHUB_OAUTH_CLIENT_ID=your-github-oauth-app-client-id
# GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-app-client-secret
